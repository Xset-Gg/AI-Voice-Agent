# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO

# ---- URLs ----
# Public HTTPS URL of the API (Twilio webhooks + Google OAuth callback point here).
# For local testing with real phone calls, use a tunnel such as ngrok or cloudflared.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Baked into the frontend image at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Security (required) ----
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Shared secret between the API and the voice agent worker (24+ chars).
INTERNAL_API_TOKEN=change-me-to-another-random-string

# ---- AI providers ----
# OpenAI is the primary; Gemini is the automatic fallback when OpenAI fails or runs out of credits.
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_PROVIDER=openai          # openai | gemini  (run "Reindex" after changing)
# Speech: Deepgram is preferred for STT; Cartesia is optional for TTS.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# ---- LiveKit (real-time voice) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# e.g. xxxx.sip.livekit.cloud
LIVEKIT_SIP_HOST=
# filled in by: docker compose exec api python -m app.setup_outbound
LIVEKIT_OUTBOUND_TRUNK_ID=
LIVEKIT_AGENT_NAME=voice-agent

# ---- Twilio (phone numbers) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURES=true
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
# Outbound calling: filled in by `docker compose exec api python -m app.setup_outbound`
TWILIO_CALLER_ID=
TWILIO_TERMINATION_URI=
TWILIO_TRUNK_USERNAME=
TWILIO_TRUNK_PASSWORD=
TWILIO_OUTBOUND_NUMBERS=

# ---- Google Calendar (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Local ports (docker compose) ----
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
QDRANT_HOST_PORT=6333
API_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
